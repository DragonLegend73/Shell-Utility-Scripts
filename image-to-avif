#!/usr/bin/env fish
# Converts all .jpg/.jpeg/.png to .avif, trashes originals.
#
# Default:
#   Quality: 60
#   Speed:   6
#
# Files are processed in natural filename order.
#
# Shows:
#   - total conversion time
#   - average time per image
#   - source/output sizes
#   - total space saved
#   - percentage reduction
#   - success/failure count
#   - average and total throughput
#
# Use -q for quality, -s for encoder speed, -l for lossless,
# -r for recursive processing, and -k to keep originals.

function show_help
    echo "Usage: image-to-avif [-q N] [-s N] [-l] [-r] [-k] [-h]"
    echo ""
    echo "Converts all .jpg/.jpeg/.png in the current folder to .avif,"
    echo "trashing originals."
    echo ""
    echo "Files are processed in natural filename order."
    echo ""
    echo "Options:"
    echo "  -q, --quality N       Color quality, 0-100 (default: 60)"
    echo "  -s, --speed N         Encoder speed, 0-10 (default: 6)"
    echo "  -l, --lossless        Use lossless AVIF encoding"
    echo "  -r, --recursive       Also process subfolders"
    echo "  -k, --keep            Keep original files instead of trashing them"
    echo "  -h, --help            Show this help and exit"
end

# ───────────── pinned progress bar (bottom row) ─────────────
set -g __pb_on 0
set -g __pb_rows 0
set -g __pb_state 0 "" ""

function pb_start
    isatty stdout; or return
    set -g __pb_rows $LINES
    test -z "$__pb_rows"; and set -g __pb_rows 24
    test $__pb_rows -ge 5; or return
    printf '\n\x1b7\x1b[1;%dr\x1b8\x1b[A' (math $__pb_rows - 1)
    set -g __pb_on 1
end

# usage: pb_draw FRACTION(0..1) LABEL INFO
function pb_draw --argument-names frac label info
    set -g __pb_state $frac "$label" "$info"
    test $__pb_on -eq 1; or return
    set -l cols $COLUMNS
    test -z "$cols"; and set cols 80
    set -l f (math "min(1, max(0, $frac))")
    set -l pct (math "floor(100 * $f)")
    set -l bw 40
    set -l filled (math "round($bw * $f)")
    set -l bar (string join '' (string repeat -n $filled '█') (string repeat -n (math "$bw - $filled") '░'))
    set -l line (printf '%-11s %s %3d%%  %s' "$label" "$bar" $pct "$info") # CHANGED: %-10s -> %-11s ("Compressing" is 11 chars)
    set line (string shorten -m (math "$cols - 1") -- "$line") # CHANGED: was `string sub -l`; shorten is width-aware, so CJK file names (2 cells each) can't overflow the row
    printf '\x1b7\x1b[%d;1H\x1b[2K%s\x1b8' $__pb_rows "$line"
end

function pb_stop
    test $__pb_on -eq 1; or return
    set -g __pb_on 0
    printf '\x1b7\x1b[r\x1b8'
    printf '\x1b7\x1b[%d;1H\x1b[2K\x1b8' $__pb_rows
end

function __pb_on_exit --on-event fish_exit
    pb_stop
end

function __pb_on_int --on-signal INT
    pb_stop
    exit 130
end

function __pb_on_winch --on-signal WINCH
    test $__pb_on -eq 1; or return
    set -g __pb_rows $LINES
    test -z "$__pb_rows"; and set -g __pb_rows 24
    printf '\x1b7\x1b[1;%dr\x1b8' (math $__pb_rows - 1)
    pb_draw $__pb_state
end
# ──────────────────────────────────────────────────────────

argparse \
    'q/quality=' \
    's/speed=' \
    l/lossless \
    r/recursive \
    k/keep \
    h/help \
    -- $argv
or exit 1

if set -q _flag_help
    show_help
    exit 0
end

set quality 60
set speed 6
set max_jobs (math (nproc) - 2)
test $max_jobs -lt 1; and set max_jobs 1

if set -q _flag_quality
    set quality $_flag_quality
end

if set -q _flag_speed
    set speed $_flag_speed
end

if set -q _flag_quality; and set -q _flag_lossless
    echo "Error: use either -q or -l, not both."
    exit 1
end

if not string match -rq '^[0-9]+$' -- $quality; or test $quality -lt 0; or test $quality -gt 100
    echo "Error: quality must be between 0 and 100."
    exit 1
end

if not string match -rq '^[0-9]+$' -- $speed; or test $speed -lt 0; or test $speed -gt 10
    echo "Error: speed must be between 0 and 10."
    exit 1
end

# Check required commands
for cmd in avifenc stat sort date
    if not command -q $cmd
        echo "Error: required command '$cmd' is not installed." >&2
        exit 1
    end
end

if not set -q _flag_keep; and not command -q gio
    echo "Warning: 'gio' command not found. Originals will be kept." >&2
    set _flag_keep 1
end

# Find files
if set -q _flag_recursive
    set files (find . -name '.git' -prune -o -name 'avif-benchmark-*' -prune -o -type f \( \
        -iname '*.jpg' -o \
        -iname '*.jpeg' -o \
        -iname '*.png' \
    \) -print)
else
    set files (path filter -f *.jpg *.jpeg *.png *.JPG *.JPEG *.PNG 2>/dev/null)
end

if test (count $files) -eq 0
    echo "No .jpg/.jpeg/.png files found."
    exit 0
end

# Natural filename sorting
set files (printf '%s\n' $files | sort -V)

set total (count $files)
set total_bytes 0
for f in $files
    set total_bytes (math $total_bytes + (stat -c %s -- "$f"))
end
test $total_bytes -gt 0; or set total_bytes 1
set done_bytes 0
set processed 0
set failed 0

set total_source_bytes 0
set total_output_bytes 0
set total_encode_seconds 0

set trashed_count 0
set trashed_bytes 0
set kept_count 0
set trash_failed_count 0

# Start timer
set start_ns (date +%s%N)

echo "========================================"
echo "IMAGE TO AVIF CONVERTER"
echo "========================================"
echo "Files:     $total image(s)"
if set -q _flag_lossless
    echo "Quality:   Lossless"
else
    echo "Quality:   $quality"
end
echo "Speed:     $speed"
echo "========================================"
echo ""

pb_start
pb_draw 0 Converting "0/$total"

for f in $files
    set processed (math $processed + 1)

    set out (string replace -r '(?i)\.(jpe?g|png)$' '.avif' -- "$f")

    set source_size (stat -c %s -- "$f")
    set total_source_bytes (math $total_source_bytes + $source_size)
    pb_draw (math "$done_bytes / $total_bytes") Converting "$processed/$total  $f"

    # Per-file timer
    set file_start_ns (date +%s%N)

    if set -q _flag_lossless
        avifenc --lossless -s $speed -j $max_jobs -- "$f" "$out" >/dev/null 2>&1
    else
        avifenc -q $quality -s $speed -j $max_jobs -- "$f" "$out" >/dev/null 2>&1
    end

    set encode_status $status

    # If it fails, retry ignoring metadata (often caused by invalid Exif chunks)
    if test $encode_status -ne 0
        if set -q _flag_lossless
            avifenc --ignore-exif --ignore-xmp --ignore-profile --lossless -s $speed -j $max_jobs -- "$f" "$out" >/dev/null 2>&1
        else
            avifenc --ignore-exif --ignore-xmp --ignore-profile -q $quality -s $speed -j $max_jobs -- "$f" "$out" >/dev/null 2>&1
        end
        set encode_status $status
    end

    set file_end_ns (date +%s%N)
    set file_elapsed (math "($file_end_ns - $file_start_ns) / 1000000000")

    set total_encode_seconds (math "$total_encode_seconds + $file_elapsed")

    if test $encode_status -eq 0; and test -f "$out"
        set output_size (stat -c %s -- "$out")
        set total_output_bytes (math $total_output_bytes + $output_size)
        printf '[%d/%d] %s  %.2f -> %.2f MiB (%.1f%% saved, %.1fs)\n' \
            $processed $total "$f" \
            (math "$source_size / 1048576") (math "$output_size / 1048576") \
            (math "100 * (1 - $output_size / max(1, $source_size))") $file_elapsed

        if not set -q _flag_keep
            gio trash -- "$f" >/dev/null 2>&1
            if test $status -eq 0
                set trashed_count (math $trashed_count + 1)
                set trashed_bytes (math $trashed_bytes + $source_size)
            else
                set trash_failed_count (math $trash_failed_count + 1)
            end
        else
            set kept_count (math $kept_count + 1)
        end
    else
        set failed (math $failed + 1)
        echo "[$processed/$total] ERROR: failed to encode '$f'" >&2
    end

    set done_bytes (math $done_bytes + $source_size)
    set running_saved_bytes (math "$total_source_bytes - $total_output_bytes")
    set running_saved_mib (printf "%.1f" (math "$running_saved_bytes / 1048576"))
    pb_draw (math "$done_bytes / $total_bytes") Converting "$processed/$total  $running_saved_mib MiB saved"
end

set end_ns (date +%s%N)
set total_seconds (math "($end_ns - $start_ns) / 1000000000")

set successful (math $total - $failed)

pb_draw 1 Converting "$total/$total  done"
pb_stop
echo ""
echo "========================================"
echo SUMMARY
echo "========================================"

# Helper values
set source_mib (math "$total_source_bytes / 1048576")
set output_mib (math "$total_output_bytes / 1048576")
set saved_bytes (math "$total_source_bytes - $total_output_bytes")
set saved_mib (math "$saved_bytes / 1048576")

if test $total_source_bytes -gt 0
    set reduction (math "100 * $saved_bytes / $total_source_bytes")
else
    set reduction 0
end

if test $successful -gt 0
    set avg_time (math "$total_encode_seconds / $successful")
else
    set avg_time 0
end

if test $total_seconds -gt 0
    set throughput (math "$source_mib / $total_seconds")
else
    set throughput 0
end

echo "Successful:          $successful"
echo "Failed:              $failed"
echo "Source size:         "(printf "%.2f" $source_mib)" MiB"
echo "AVIF size:           "(printf "%.2f" $output_mib)" MiB"
echo "Space saved:         "(printf "%.2f" $saved_mib)" MiB"
echo "Size reduction:      "(printf "%.2f" $reduction)"%"
set trashed_mib (math "$trashed_bytes / 1048576")
echo "Items trashed:       $trashed_count ("(printf "%.2f" $trashed_mib)" MiB)"
echo "Total time:          "(printf "%.2f" $total_seconds)" seconds"
echo "Average/image:       "(printf "%.3f" $avg_time)" seconds"
echo "Throughput:          "(printf "%.2f" $throughput)" MiB/s"
echo "========================================"
echo ""
echo "Done."
