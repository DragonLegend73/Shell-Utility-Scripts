#!/usr/bin/env fish
# Group *.webp and *.avif files and directories by their first two '_'
# delimited fields into "<key>.zip", then trash the originals.
#
# Files inside each ZIP are added in natural filename order.
#
# -k / --keep:  keep originals (skip gio trash)
# -h / --help:  show this help and exit

function show_help
    echo "Usage: pawchive-zip [-k | --keep] [-h | --help]"
    echo ""
    echo "  Groups *.webp and *.avif files and directories by their first two"
    echo "  '_' delimited fields into <key>.zip:"
    echo ""
    echo "    82182829_Hasumi parasite futa_01_1.webp -> 82182829_Hasumi parasite futa.zip"
    echo "    82182829_Hasumi parasite futa_01_1.avif -> 82182829_Hasumi parasite futa.zip"
    echo "    pawchive_10007083_2.webp                -> pawchive_10007083.zip"
    echo "    pawchive_10007083_2.avif                -> pawchive_10007083.zip"
    echo "    5581744_沙花叉クロヱ_002_Chloe_feet/     -> 5581744_沙花叉クロヱ.zip"
    echo ""
    echo "  Files are added to ZIPs in natural filename order."
    echo ""
    echo "  -k, --keep     don't move originals to trash after zipping"
    echo "  -h, --help     show this help and exit"
end

argparse 'h/help' 'k/keep' -- $argv
or exit 1

if set -q _flag_help
    show_help
    exit 0
end

for cmd in zip sort
    if not command -q $cmd
        echo "Error: required command '$cmd' is not installed." >&2
        exit 1
    end
end

if not set -q _flag_keep; and not command -q gio
    echo "Warning: 'gio' command not found. Originals will be kept." >&2
    set _flag_keep 1
end

set webp_files (path filter -f *.webp *.WEBP *.WebP 2>/dev/null)
set avif_files (path filter -f *.avif *.AVIF *.Avif 2>/dev/null)

set dirs
for d in (path filter -t dir * 2>/dev/null)
    set -a dirs (string trim -r -c / -- "$d")
end

if test (count $webp_files) -eq 0; and test (count $avif_files) -eq 0; and test (count $dirs) -eq 0
    echo "No .webp/.avif files or directories found in this directory." >&2
    exit 1
end

# Natural-sort each collection
if test (count $webp_files) -gt 0
    set webp_files (printf '%s\n' $webp_files | sort -V)
end

if test (count $avif_files) -gt 0
    set avif_files (printf '%s\n' $avif_files | sort -V)
end

if test (count $dirs) -gt 0
    set dirs (printf '%s\n' $dirs | sort -V)
end

# Extract unique keys from .webp files, .avif files and directories
set keys

for f in $webp_files
    set base_name (string replace -r '(?i)\.webp$' '' -- (basename -- "$f"))
    set parts (string split '_' -- "$base_name")

    if test (count $parts) -ge 2
        set -a keys (string join '_' $parts[1..2])
    else
        set -a keys $parts[1]
    end
end

for f in $avif_files
    set base_name (string replace -r '(?i)\.avif$' '' -- (basename -- "$f"))
    set parts (string split '_' -- "$base_name")

    if test (count $parts) -ge 2
        set -a keys (string join '_' $parts[1..2])
    else
        set -a keys $parts[1]
    end
end

for d in $dirs
    set parts (string split '_' -- "$d")

    if test (count $parts) -ge 2
        set -a keys (string join '_' $parts[1..2])
    else
        set -a keys $parts[1]
    end
end

# Natural sort + remove duplicates
set keys (printf '%s\n' $keys | sort -Vu)

for key in $keys
    set files
    set matching_dirs

    # Find matching .webp files
    for f in $webp_files
        set base_name (string replace -r '(?i)\.webp$' '' -- (basename -- "$f"))
        set parts (string split '_' -- "$base_name")

        if test (count $parts) -ge 2
            set file_key (string join '_' $parts[1..2])
        else
            set file_key $parts[1]
        end

        if test "$file_key" = "$key"
            set -a files "$f"
        end
    end

    # Find matching .avif files
    for f in $avif_files
        set base_name (string replace -r '(?i)\.avif$' '' -- (basename -- "$f"))
        set parts (string split '_' -- "$base_name")

        if test (count $parts) -ge 2
            set file_key (string join '_' $parts[1..2])
        else
            set file_key $parts[1]
        end

        if test "$file_key" = "$key"
            set -a files "$f"
        end
    end

    # Find matching directories
    for d in $dirs
        set parts (string split '_' -- "$d")

        if test (count $parts) -ge 2
            set dir_key (string join '_' $parts[1..2])
        else
            set dir_key $parts[1]
        end

        if test "$dir_key" = "$key"
            set -a matching_dirs "$d"
        end
    end

    if test (count $files) -eq 0; and test (count $matching_dirs) -eq 0
        continue
    end

    # Combine files and directories and natural-sort them
    set zip_items $files $matching_dirs
    set zip_items (printf '%s\n' $zip_items | sort -V)

    echo ""
    echo "Creating: $key.zip"

    # Zip WebP, AVIF and directories together
    zip -r "$key.zip" -- $zip_items

    # Only trash originals if zip succeeded
    if test $status -ne 0
        echo "ERROR: Failed to create '$key.zip'. Originals were NOT trashed." >&2
        continue
    end

    if not set -q _flag_keep
        if test (count $files) -gt 0
            gio trash -- $files
        end

        if test (count $matching_dirs) -gt 0
            gio trash -- $matching_dirs
        end
    end
end
