#!/usr/bin/env fish
# Converts .pdf files to lossless PNG images.
# Extracts 1:1 native images directly from the PDF container as PNG.
# Output is placed in a folder named after the PDF.
#
# Requirements: poppler (pdfimages), stat, sort.

# ───────────── pinned progress bar (bottom row) ─────────────
set -g __pb_on 0
set -g __pb_rows 0
set -g __pb_state 0 "" ""

function pb_start
    isatty stdout; or return
    set -g __pb_rows (tput lines 2>/dev/null)
    string match -qr '^\d+$' -- "$__pb_rows"; or return
    test $__pb_rows -ge 5; or return
    printf '\n\x1b7\x1b[1;%dr\x1b8\x1b[A' (math $__pb_rows - 1)
    set -g __pb_on 1
end

# usage: pb_draw FRACTION(0..1) LABEL INFO
function pb_draw --argument-names frac label info
    set -g __pb_state $frac "$label" "$info"
    test $__pb_on -eq 1; or return
    set -l cols (tput cols 2>/dev/null; or echo 80)
    set -l f (math "min(1, max(0, $frac))")
    set -l pct (math "floor(100 * $f)")
    set -l bw 40
    set -l filled (math "round($bw * $f)")
    set -l bar (string join '' (string repeat -n $filled '█') (string repeat -n (math "$bw - $filled") '░'))
    set -l line (printf '%-11s %s %3d%%  %s' "$label" "$bar" $pct "$info") # CHANGED: %-10s -> %-11s ("Compressing" is 11 chars)
    set line (string shorten -m (math "$cols - 1") -- "$line") # CHANGED: was `string sub -l`; shorten is width-aware, so CJK file names (2 cells each) can't overflow the row
    printf '\x1b7\x1b[%d;1H\x1b[2K%s\x1b8' $__pb_rows "$line"
end

function pb_stop
    test $__pb_on -eq 1; or return
    set -g __pb_on 0
    printf '\x1b7\x1b[r\x1b8'
    printf '\x1b7\x1b[%d;1H\x1b[2K\x1b8' $__pb_rows
end

function __pb_on_exit --on-event fish_exit
    pb_stop
end

function __pb_on_int --on-signal INT
    pb_stop
    exit 130
end

function __pb_on_winch --on-signal WINCH
    test $__pb_on -eq 1; or return
    set -g __pb_rows (tput lines 2>/dev/null)
    printf '\x1b7\x1b[1;%dr\x1b8' (math $__pb_rows - 1)
    pb_draw $__pb_state
end
# ──────────────────────────────────────────────────────────

function show_help
    echo "Usage: pdf-to-png [-r] [-k] [-h]"
    echo ""
    echo "Extracts every .pdf into lossless PNG files inside a"
    echo "folder named after the PDF, then trashes the original."
    echo ""
    echo "  Artwork Collection.pdf -> Artwork Collection/"
    echo "                              Artwork Collection 1.png"
    echo "                              Artwork Collection 2.png"
    echo ""
    echo "Options:"
    echo "  -r, --recursive     Process subfolders recursively"
    echo "  -k, --keep          Keep original PDFs instead of trashing them"
    echo "  -h, --help          Show this help and exit"
end

argparse \
    r/recursive \
    k/keep \
    h/help \
    -- $argv
or exit 1

if set -q _flag_help
    show_help
    exit 0
end

# Check required commands
for cmd in pdfimages stat sort date
    if not command -q $cmd
        echo "Error: required command '$cmd' is not installed." >&2
        exit 1
    end
end

if not set -q _flag_keep; and not command -q gio
    echo "Warning: 'gio' command not found. Originals will be kept." >&2
    set _flag_keep 1
end

# Collect PDF files
if set -q _flag_recursive
    set pdfs (find . -name '.git' -prune -o -name 'avif-benchmark-*' -prune -o -type f \( -iname '*.pdf' \) -print)
else
    set pdfs (path filter -f *.pdf *.PDF 2>/dev/null)
end

if test (count $pdfs) -eq 0
    echo "No .pdf files found."
    exit 0
end

set pdfs (printf '%s\n' $pdfs | sort -V)
set total (count $pdfs)

# one row per extractable image (pdfimages -list prints 2 header lines first)
set pdf_units
set total_units 0
for p in $pdfs
    set c (pdfimages -list -- "$p" 2>/dev/null | tail -n +3 | count)
    test $c -ge 1; or set c 1
    set -a pdf_units $c
    set total_units (math $total_units + $c)
end
set done_units 0
set n 1
set processed_pdfs

set successful_count 0
set failed_count 0
set total_pages_count 0
set trashed_count 0

echo "========================================"
echo "PDF TO PNG EXTRACTOR"
echo "========================================"
echo "PDF files:  $total"
echo "========================================"
echo ""

set start_ns (date +%s%N)

pb_start
pb_draw 0 Extracting "0/$total"

for pdf in $pdfs
    set dir (dirname -- "$pdf")
    set base (basename -- "$pdf")
    set name (string replace -r '(?i)\.pdf$' '' -- "$base")

    echo "[$n/$total] Processing: $pdf"

    set out_dir "$dir/$name"
    mkdir -p "$out_dir"

    set tmp_dir "$dir/.tmp_pdf_png_$n"
    mkdir -p "$tmp_dir"

    # Extract native images as PNG
    pdfimages -png -- "$pdf" "$tmp_dir/img" &
    set pdf_pid $last_pid
    while kill -0 $pdf_pid 2>/dev/null
        set k (find "$tmp_dir" -maxdepth 1 -type f | count)
        pb_draw (math "min($done_units + $k, $total_units) / $total_units") Extracting "$n/$total  $name"
        sleep 0.2
    end
    wait $pdf_pid

    set extracted (path filter -f "$tmp_dir/"* 2>/dev/null)

    if test (count $extracted) -gt 0
        set extracted (printf '%s\n' $extracted | sort -V)
        set p 1
        for img in $extracted
            set target "$out_dir/$name $p.png"
            mv -- "$img" "$target"
            set p (math $p + 1)
        end
        set -a processed_pdfs "$pdf"
        set page_count (math $p - 1)
        echo "  -> Extracted $page_count page(s) to $out_dir/"
        set successful_count (math $successful_count + 1)
        set total_pages_count (math $total_pages_count + $page_count)
    else
        echo "  -> Warning: No images extracted from '$pdf'." >&2
        rmdir "$out_dir" 2>/dev/null
        set failed_count (math $failed_count + 1)
    end

    rm -rf "$tmp_dir"
    set done_units (math $done_units + $pdf_units[$n])
    pb_draw (math "$done_units / $total_units") Extracting "$n/$total  $name"
    set n (math $n + 1)
end

if not set -q _flag_keep; and test (count $processed_pdfs) -gt 0
    gio trash -- $processed_pdfs
    set trashed_count (count $processed_pdfs)
end

set end_ns (date +%s%N)
set total_seconds (math -s 2 "($end_ns - $start_ns) / 1000000000")

pb_draw 1 Extracting "$total/$total  done"
pb_stop
echo "========================================"
echo SUMMARY
echo "========================================"
echo "Successful:          $successful_count"
echo "Failed:              $failed_count"
echo "Total pages:         $total_pages_count"
echo "PDFs trashed:        $trashed_count"
echo "Total time:          $total_seconds seconds"
echo "========================================"
echo "Done."
