#!/usr/bin/env fish
# Extracts .zip, .rar, and .7z files.
# Default: each archive gets its own folder (same dir as the archive).
# Auto-detects and decodes Shift-JIS / CP932 / CP949 encodings to fix garbled filenames.
#
# -e/--encoding   specify character encoding for zip filenames (default: shift-jis)
# -r/--recursive  find archives in subfolders too
# -f/--flatten    dump contents directly into the archive's folder
# -k/--keep       keep archive files instead of trashing them
# -p/--passwords  specify a custom password dictionary file
#
# Passwords:
#   Automatically tries passwords from:
#     ~/.config/archive-passwords.txt (or custom path via -p)

# ───────────── pinned progress bar (bottom row) ─────────────
set -g __pb_on 0
set -g __pb_rows 0
set -g __pb_state 0 "" ""

function pb_start
    isatty stdout; or return
    set -g __pb_rows $LINES
    test -z "$__pb_rows"; and set -g __pb_rows 24
    test $__pb_rows -ge 5; or return
    # newline (make room), save cursor, shrink scroll region, restore cursor, step back up
    printf '\n\x1b7\x1b[1;%dr\x1b8\x1b[A' (math $__pb_rows - 1)
    set -g __pb_on 1
end

# usage: pb_draw FRACTION(0..1) LABEL INFO
function pb_draw --argument-names frac label info
    set -g __pb_state $frac "$label" "$info"
    test $__pb_on -eq 1; or return
    set -l cols $COLUMNS
    test -z "$cols"; and set cols 80
    set -l f (math "min(1, max(0, $frac))")
    set -l pct (math "floor(100 * $f)")
    set -l bw 40
    set -l filled (math "round($bw * $f)")
    # string join, NOT (cmd)(cmd): an empty substitution would blank the whole bar
    set -l bar (string join '' (string repeat -n $filled '█') (string repeat -n (math "$bw - $filled") '░'))
    set -l line (printf '%-11s %s %3d%%  %s' "$label" "$bar" $pct "$info")
    set line (string shorten -m (math "$cols - 1") -- "$line")
    printf '\x1b7\x1b[%d;1H\x1b[2K%s\x1b8' $__pb_rows "$line"
end

function pb_stop
    test $__pb_on -eq 1; or return
    set -g __pb_on 0
    printf '\x1b7\x1b[r\x1b8' # reset scroll region, keep cursor
    printf '\x1b7\x1b[%d;1H\x1b[2K\x1b8' $__pb_rows # wipe the bar row
end

function __pb_on_exit --on-event fish_exit
    pb_stop
end

function __pb_on_int --on-signal INT
    pb_stop
    exit 130
end

function __pb_on_winch --on-signal WINCH
    test $__pb_on -eq 1; or return
    set -g __pb_rows $LINES
    test -z "$__pb_rows"; and set -g __pb_rows 24
    printf '\x1b7\x1b[1;%dr\x1b8' (math $__pb_rows - 1)
    pb_draw $__pb_state
end
# ──────────────────────────────────────────────────────────

# Line-buffer zip/unzip output so lines appear live instead of in big chunks
set unbuf
command -q stdbuf; and set unbuf stdbuf -oL

# prints one line of tool output; strips 7z's \r progress chatter, skips empties
function show_line --argument-names line
    set -l clean (string replace -r '.*\r' '' -- "$line")
    test -n "$clean"; and printf '%s\n' "$clean"
end

set password_file ~/.config/archive-passwords.txt

function show_help
    echo "Usage: unzip-all [-e ENCODING] [-p FILE] [-r] [-f] [-k]"
    echo ""
    echo "Extracts .zip, .rar, and .7z files."
    echo "Default: each archive gets its own folder (same dir as the archive)."
    echo ""
    echo "  -e, --encoding NAME  Encoding for ZIP filenames (default: shift-jis, fixes garbled CJK text)"
    echo "  -p, --passwords FILE Custom password dictionary file"
    echo "  -r, --recursive      find archives in subfolders too (not just cwd)"
    echo "  -f, --flatten        dump contents directly into the archive's folder"
    echo "  -k, --keep           keep archive files instead of trashing them"
    echo "  -h, --help           show this help and exit"
    echo ""
    echo "Password file used by default:"
    echo "  $password_file"
end

argparse h/help r/recursive f/flatten k/keep 'e/encoding=' 'p/passwords=' -- $argv
or exit 1

if set -q _flag_help
    show_help
    exit 0
end

if set -q _flag_passwords
    set password_file $_flag_passwords
end

set zip_encoding shift-jis
if set -q _flag_encoding
    set zip_encoding $_flag_encoding
end

if not command -q 7z; and not command -q unzip
    echo "Error: neither '7z' nor 'unzip' is installed." >&2
    exit 1
end

if not set -q _flag_keep; and not command -q gio
    echo "Warning: 'gio' command not found. Archives will be kept." >&2
    set _flag_keep 1
end

# -------------------------------------------------------------------
# Load stored passwords
# -------------------------------------------------------------------

set stored_passwords

if test -f "$password_file"
    while read -l line
        set line (string trim -- "$line")

        if test -z "$line"; or string match -q '#*' -- "$line"
            continue
        end

        set -a stored_passwords "$line"
    end <"$password_file"
end

set session_passwords

# -------------------------------------------------------------------
# Collect archives
# -------------------------------------------------------------------

set archives

if set -q _flag_recursive
    set archives (find . -name '.git' -prune -o -name 'avif-benchmark-*' -prune -o -type f \( \
        -iname '*.zip' -o \
        -iname '*.rar' -o \
        -iname '*.7z' \
    \) -print)
else
    set archives (path filter -f *.zip *.ZIP *.rar *.RAR *.7z *.7Z 2>/dev/null)
end

if test (count $archives) -eq 0
    echo "No .zip, .rar, or .7z files found."
    exit 0
end

set archives (printf '%s\n' $archives | sort -V)
set total_archives (count $archives)

set archive_sizes
set total_bytes 0
for a in $archives
    set s (stat -c %s -- "$a" 2>/dev/null; or echo 0)
    set -a archive_sizes $s
    set total_bytes (math $total_bytes + $s)
end
test $total_bytes -gt 0; or set total_bytes 1
set done_bytes 0

echo "========================================"
echo "ARCHIVE EXTRACTOR"
echo "========================================"
echo "Archives:   $total_archives file(s)"
echo "Encoding:   $zip_encoding"
echo "Passwords:  "(count $stored_passwords)" stored"
echo "========================================"

pb_start
pb_draw 0 Extracting "0/$total_archives"

# -------------------------------------------------------------------
# Extract archives
# -------------------------------------------------------------------

set successful_count 0
set failed_count 0
set trashed_count 0
set trashed_size 0
set kept_count 0
set current_archive_num 1
set start_ns (date +%s%N)

for archive in $archives
    set dir (dirname -- "$archive")
    set base (basename -- "$archive")
    set base (string replace -r '(?i)\.(zip|rar|7z)$' '' -- "$base")

    set arc_bytes $archive_sizes[$current_archive_num]
    set -g cur_info "$current_archive_num/$total_archives  $base"
    set -g cur_frac (math "$done_bytes / $total_bytes")
    echo "[$current_archive_num/$total_archives] Extracting: $archive"
    pb_draw $cur_frac Extracting "$cur_info"

    if set -q _flag_flatten
        set output_dir "$dir"
    else
        set output_dir "$dir/$base"
        mkdir -p "$output_dir"
    end

    set extract_status 1

    # Check if archive is a ZIP and unzip command supports encoding flag (-O)
    set is_zip (string match -ri '(?i)\.zip$' -- "$archive")

    # 1. Try unzip with specified encoding if it's a zip file
    if test -n "$is_zip"; and command -q unzip
        set -l entries (unzip -Z1 -- "$archive" 2>/dev/null | count)
        set -l stride (math "max(1, ceil($entries / 50))")
        set -l k 0
        set -l next 1
        $unbuf unzip -O "$zip_encoding" -o -- "$archive" -d "$output_dir" 2>&1 | while read -l line
            printf '%s\n' "$line"
            if string match -qr '^\s*(inflating|extracting|creating|linking):' -- "$line"
                set k (math $k + 1)
                if test $k -ge $next
                    set next (math $k + $stride)
                    pb_draw (math "($done_bytes + $arc_bytes * min(1, $k / max(1, $entries))) / $total_bytes") Extracting "$cur_info"
                end
            end
        end
        set extract_status $pipestatus[1]
    end

    # 2. Try 7z without password if unzip failed or non-zip
    if test $extract_status -ne 0; and command -q 7z
        $unbuf 7z x -y -- "$archive" "-o$output_dir" 2>&1 | while read -l line
            show_line "$line"
        end
        set extract_status $pipestatus[1]
    end

    # 3. Try stored passwords with 7z
    if test $extract_status -ne 0; and command -q 7z
        for password in $stored_passwords
            printf "Trying stored password...\n"
            $unbuf 7z x -y "-p$password" -- "$archive" "-o$output_dir" 2>&1 | while read -l line
                show_line "$line"
            end
            set extract_status $pipestatus[1]
            if test $extract_status -eq 0
                printf "Stored password matched.\n"
                break
            end
        end
    end

    # 4. Try session passwords
    if test $extract_status -ne 0; and command -q 7z
        for password in $session_passwords
            printf "Trying previously entered password...\n"
            $unbuf 7z x -y "-p$password" -- "$archive" "-o$output_dir" 2>&1 | while read -l line
                show_line "$line"
            end
            set extract_status $pipestatus[1]
            if test $extract_status -eq 0
                printf "Previously entered password matched.\n"
                break
            end
        end
    end

    # 5. Manual password entry
    if test $extract_status -ne 0; and command -q 7z
        printf "Stored passwords did not work.\n"
        read -s -P "Enter password: " manual_password
        echo ""
        $unbuf 7z x -y "-p$manual_password" -- "$archive" "-o$output_dir" 2>&1 | while read -l line
            show_line "$line"
        end
        set extract_status $pipestatus[1]
        if test $extract_status -eq 0
            printf "Manual password worked.\n"
            if not contains -- "$manual_password" $session_passwords
                set -a session_passwords "$manual_password"
            end
        else
            printf "Manual password failed.\n"
        end
    end

    # 6. Check extraction result
    if test $extract_status -eq 0
        set successful_count (math $successful_count + 1)
        set extr_files (find "$output_dir" -type f 2>/dev/null)
        set extr_count (count $extr_files)
        set extr_size 0
        for f in $extr_files
            set f_size (stat -c %s -- "$f" 2>/dev/null; or echo 0)
            set extr_size (math $extr_size + $f_size)
        end
        printf "Extraction successful (%d files, %s MiB).\n" $extr_count (math -s 2 "$extr_size / 1048576")
        if not set -q _flag_keep
            set a_size (stat -c %s -- "$archive" 2>/dev/null; or echo 0)
            gio trash -- "$archive"
            set trashed_count (math $trashed_count + 1)
            set trashed_size (math $trashed_size + $a_size)
        else
            set kept_count (math $kept_count + 1)
        end
    else
        set failed_count (math $failed_count + 1)
        printf "\n"
        printf "ERROR: Failed to extract '%s'.\n" "$archive" >&2
        printf "Archive was NOT trashed.\n" >&2
    end

    set done_bytes (math $done_bytes + $arc_bytes)
    pb_draw (math "$done_bytes / $total_bytes") Extracting "$current_archive_num/$total_archives"
    set current_archive_num (math $current_archive_num + 1)
end

rm -f /tmp/unzip-all-output.txt

set end_ns (date +%s%N)
set total_seconds (math -s 2 "($end_ns - $start_ns) / 1000000000")
set trashed_mb (math -s 2 "$trashed_size / 1048576")

pb_draw 1 Extracting "$total_archives/$total_archives  done"
pb_stop
echo "========================================"
echo "SUMMARY  "
echo "========================================"
echo "Successful:          $successful_count"
echo "Failed:              $failed_count"
echo "Archives trashed:    $trashed_count ($trashed_mb MiB)"
echo "Archives kept:       $kept_count"
echo "Total time:          $total_seconds seconds"
echo "========================================"
echo "Done."
