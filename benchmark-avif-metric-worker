#!/usr/bin/env bash
# Metric worker for benchmark-avif — computes SSIMULACRA 2

SRC="$1"
AVIF="$2"
RESULT="$3"
SSIM_CMD="$4"
SSIM_EXTRA="$5"

ssimulacra_val=""

if [ -n "$SSIM_CMD" ]; then
    metric_output=$($SSIM_CMD $SSIM_EXTRA "$SRC" "$AVIF" 2>/dev/null)
    ssimulacra_val=$(echo "$metric_output" | grep -oP '[-+]?[\d]*\.?[\d]+([eE][-+]?[\d]+)?' | head -1)
    if [ -n "$ssimulacra_val" ]; then
        in_range=$(awk -v v="$ssimulacra_val" 'BEGIN { print (v >= -100 && v <= 100) ? 1 : 0 }')
        if [ "$in_range" != "1" ]; then
            ssimulacra_val=""
        fi
    fi
fi

echo "$ssimulacra_val" > "$RESULT"
