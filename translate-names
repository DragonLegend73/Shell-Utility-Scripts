#!/usr/bin/env python3
"""
Translates CJK zip file names to English using the Gemini API.
Fandom-aware: correctly localizes anime, game, and ACG character names.

Usage:
    translate-names [-n] [-r] [path...]

Options:
    -n, --dry-run     Preview renames without changing files
    -r, --recursive   Process subdirectories recursively
"""

import os
import re
import sys
import json
import time
import argparse
import urllib.request
import urllib.error
import atexit
import shutil
import signal
import unicodedata

GEMINI_MODEL = "gemini-flash-lite-latest"
BATCH_SIZE = 10  # keep small for free-tier rate limits
CACHE_FILE = os.path.expanduser("~/.cache/translate-names-cache.json")


def get_api_key(args_key=None):
    if args_key:
        return args_key
    env_key = os.environ.get("GEMINI_API_KEY")
    if env_key:
        return env_key.strip()
    key_file = os.path.expanduser("~/.config/gemini-api-key")
    if os.path.exists(key_file):
        try:
            with open(key_file, "r", encoding="utf-8") as f:
                key = f.read().strip()
                if key:
                    return key
        except Exception:
            pass
    return None


def load_cache():
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}


def _fit(text, width):
    """Truncate to a terminal *cell* width (CJK characters take 2 cells)."""
    out, used = [], 0
    for ch in text:
        w = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if used + w > width:
            break
        out.append(ch)
        used += w
    return "".join(out)


class PinnedBar:
    """Overall progress bar pinned to the bottom terminal row; output scrolls above it."""

    def __init__(self):
        self.on = False
        self.rows = 0
        self.state = (0.0, "", "")

    def start(self):
        if self.on or not sys.stdout.isatty():
            return
        self.rows = shutil.get_terminal_size().lines
        if self.rows < 5:
            return
        # newline (make room), save cursor, shrink scroll region, restore cursor, step back up
        sys.stdout.write(f"\n\x1b7\x1b[1;{self.rows - 1}r\x1b8\x1b[A")
        sys.stdout.flush()
        self.on = True
        atexit.register(self.stop)
        signal.signal(signal.SIGWINCH, self._on_winch)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))

    def draw(self, frac, label, info=""):
        self.state = (frac, label, info)
        if not self.on:
            return
        cols = shutil.get_terminal_size().columns
        f = min(1.0, max(0.0, frac))
        filled = round(40 * f)
        line = f"{label:<11s} {'█' * filled}{'░' * (40 - filled)} {int(100 * f):3d}%  {info}"
        sys.stdout.write(f"\x1b7\x1b[{self.rows};1H\x1b[2K{_fit(line, cols - 1)}\x1b8")
        sys.stdout.flush()

    def stop(self):
        if not self.on:
            return
        self.on = False
        sys.stdout.write(f"\x1b7\x1b[r\x1b8\x1b7\x1b[{self.rows};1H\x1b[2K\x1b8")
        sys.stdout.flush()

    def sleep(self, seconds, why):
        """time.sleep that keeps the bar alive with a countdown."""
        frac, label, info = self.state
        end = time.time() + seconds
        while True:
            left = end - time.time()
            if left <= 0:
                break
            self.draw(frac, label, f"{why}: resuming in {int(left) + 1}s")
            time.sleep(min(1, left))
        self.draw(frac, label, info)

    def _on_winch(self, *_):
        if not self.on:
            return
        self.rows = shutil.get_terminal_size().lines
        sys.stdout.write(f"\x1b7\x1b[1;{self.rows - 1}r\x1b8")
        self.draw(*self.state)


bar = PinnedBar()


def save_cache(cache):
    try:
        os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
        with open(CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump(cache, f, ensure_ascii=False, indent=2)
    except Exception:
        pass


def contains_cjk(text):
    return bool(re.search(r"[가-힣぀-ヿ㐀-䶿一-鿿]", text))


def parse_zip_name(filename):
    """Parse '{id}_{name}.zip' -> (id, name) or None."""
    if not filename.lower().endswith(".zip"):
        return None
    stem = filename[:-4].strip()
    m = re.match(r"^(\d+)_(.+)$", stem)
    if m:
        return m.group(1), m.group(2).strip()
    return None


def parse_json_response(text):
    """Robustly parse JSON response from Gemini, handling markdown fencing and dirty syntax."""
    text = text.strip()
    if text.startswith("```"):
        lines = text.splitlines()
        if lines[0].startswith("```"):
            lines = lines[1:]
        if lines and lines[-1].startswith("```"):
            lines = lines[:-1]
        text = "\n".join(lines).strip()

    try:
        return json.loads(text)
    except json.JSONDecodeError:
        pass

    m = re.search(r"(\{.*\})", text, re.DOTALL)
    if m:
        try:
            return json.loads(m.group(1))
        except json.JSONDecodeError:
            pass

    # Clean trailing commas before closing braces/brackets
    cleaned = re.sub(r",(\s*[\}\]])", r"\1", text)
    return json.loads(cleaned)


def translate_batch(names, api_key):
    """Send a list of CJK name strings to Gemini and get translations back."""
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_MODEL}:generateContent?key={api_key}"
    numbered = "\n".join(f"{i+1}. {n}" for i, n in enumerate(names))

    prompt = f"""You are an expert translator for ACG (Anime, Comic, Game) content.
Translate each Chinese/Japanese/Korean filename below into English.

RULES — follow these exactly:
1. Use the OFFICIAL English localization for all character names, game titles, and franchises.
   Examples you must know:
   - 菈妮 → Ranni (Elden Ring)
   - 甘雨 → Ganyu (Genshin Impact)
   - 赫斯提亚 → Hestia (DanMachi)
   - 伊蕾娜 / 伊雷娜 → Elaina (Wandering Witch)
   - 佐仓杏子 → Kyoko Sakura (Madoka Magica)
   - 赛尔号 → Seer (赛尔号)
   - 脑叶公司 → Lobotomy Corporation
   - 心灵终结 → Mental Omega (Red Alert mod)
   - 罗德岛 → Rhodes Island (Arknights)
   - 王者荣耀 → Honor of Kings
   - 拉普兰德 → Lappland (Arknights)
   - 嘉维尔 → Gavial (Arknights)
   - 魁拔 → Kuiba
   - 赛莉亚 → Celia (DNF)
   - 黑木智子 → Tomoko Kuroki (WataMote)
   - 水月 → Mizuki (Arknights)
   - 夕 → Dusk (Arknights)
   - 玳萝 → Darlot / Dai Luo (keep transliteration)
   - 薇尔希 → Vyrsi / Vyrshi (keep transliteration)
   - dnf / DNF → DNF (Dungeon & Fighter)
   - 海伊德 → Heid / Heide (DNF)
   - 姬小满 → Ji Xiaoman (Honor of Kings)
   - 洛茜 → Rosie / Loxy
   - 鸣依 → Mingyi
   - 艾露 → Ailu / Elu
   - 奥古斯特 → Auguste
   - 蒂蒂 → Didi / Titi
   - 莉瑟菲娜 → Lisephina
   - 微笑教授 → Professor Smile
   - 小林 → Kobayashi
   - 茶靡 / 荼蘼 / 茶蘼 → Tumi
   - 苏芙比 → Sotheby
   - 赤蛮奇 → Sekibanki (Touhou)
   - 灵王 → Spirit King
   - 天珑 → Tianlong
   - 铃 → Rin
   - 日野 → Hino
   - 艾莉什 → Elish
   - 塞利娅 → Celia
2. 其一/其二/其三/.../其十 → Part 1/Part 2/.../Part 10
3. 稿件 → Commission
4. 绘画文件 → Art Files
5. 公开 → Public;  免费 → Free;  拆分 → Split
6. OC / oc → OC (Original Character) — keep as "OC"
7. Use Title Case.
8. Keep English words, numbers, and tags like [xxx] as-is.
9. For character names you cannot identify, transliterate naturally into English (NOT pinyin with tone marks).
10. Do NOT add explanations. Return ONLY a JSON object mapping original string to translated string.

Input names:
{numbered}

Return a JSON object mapping each original name to its English translation, like:
{{"original chinese name": "English Translation", ...}}"""

    payload = {
        "contents": [{"parts": [{"text": prompt}]}],
        "safetySettings": [
            {"category": "HARM_CATEGORY_HARASSMENT", "threshold": "BLOCK_NONE"},
            {"category": "HARM_CATEGORY_HATE_SPEECH", "threshold": "BLOCK_NONE"},
            {"category": "HARM_CATEGORY_SEXUALLY_EXPLICIT", "threshold": "BLOCK_NONE"},
            {"category": "HARM_CATEGORY_DANGEROUS_CONTENT", "threshold": "BLOCK_NONE"},
            {"category": "HARM_CATEGORY_CIVIC_INTEGRITY", "threshold": "BLOCK_NONE"},
        ],
        "generationConfig": {
            "temperature": 0.1,
            "responseMimeType": "application/json",
        },
    }

    data = json.dumps(payload).encode("utf-8")

    max_retries = 5
    for attempt in range(max_retries):
        try:
            req = urllib.request.Request(
                url,
                data=data,
                headers={"Content-Type": "application/json"},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=60) as resp:
                result = json.loads(resp.read().decode("utf-8"))

            candidates = result.get("candidates")
            if not candidates:
                feedback = result.get("promptFeedback", {})
                reason = feedback.get("blockReason", "UNKNOWN")
                raise ValueError(f"Prompt blocked by safety ({reason})")

            cand = candidates[0]
            parts = cand.get("content", {}).get("parts", [])
            if not parts or "text" not in parts[0]:
                finish = cand.get("finishReason", "UNKNOWN")
                raise ValueError(f"Empty candidate response (finishReason: {finish})")

            text = parts[0]["text"]
            return parse_json_response(text)
        except urllib.error.HTTPError as e:
            if attempt >= max_retries - 1:
                raise
            if e.code == 429:
                wait = [30, 60, 90, 120][min(attempt, 3)]
                print(
                    f"   ⚠ 429 rate limited, sleeping {wait}s (attempt {attempt+1})..."
                )
                bar.sleep(wait, "429 rate limited")
            elif e.code in (500, 503):
                print(f"   ⚠ {e.code} server busy, retrying (attempt {attempt+1})...")
                time.sleep(2)
            else:
                raise
        except Exception as e:
            if attempt >= max_retries - 1:
                raise
            print(f"   ⚠ {e}, retrying (attempt {attempt+1})...")
            time.sleep(2)


def clean_filename(name):
    """Sanitize translated name for the filesystem."""
    name = name.replace("（", " (").replace("）", ") ")
    name = re.sub(r'[\/:*?"<>|]', "", name)
    name = re.sub(r"\s*\(\s*", " (", name)
    name = re.sub(r"\s*\)\s*", ") ", name)
    name = re.sub(r"_\s+", "_", name)
    name = re.sub(r"\s+_", "_", name)
    name = re.sub(r"\s+", " ", name).strip()
    return name


def main():
    start_time = time.time()
    parser = argparse.ArgumentParser(
        description="Translate Chinese/Japanese/Korean CJK zip file names to English using Gemini AI."
    )
    parser.add_argument(
        "paths", nargs="*", default=["."], help="Directories to process"
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true", help="Preview without renaming"
    )
    parser.add_argument(
        "-r", "--recursive", action="store_true", help="Process subdirectories"
    )
    parser.add_argument(
        "--api-key",
        help="Gemini API key (or set GEMINI_API_KEY env var / ~/.config/gemini-api-key)",
    )
    args = parser.parse_args()

    api_key = get_api_key(args.api_key)

    # ── Collect zip files with CJK names ──────────────────────────────────
    targets = []  # (full_path, file_id, cjk_name)

    for p in args.paths:
        p = os.path.abspath(p)
        if not os.path.isdir(p):
            continue

        if args.recursive:
            for root, dirs, files in os.walk(p):
                if ".git" in root or "avif-benchmark-" in root:
                    continue
                for f in files:
                    parsed = parse_zip_name(f)
                    if parsed and contains_cjk(parsed[1]):
                        targets.append((os.path.join(root, f), parsed[0], parsed[1]))
        else:
            for f in os.listdir(p):
                parsed = parse_zip_name(f)
                if parsed and contains_cjk(parsed[1]):
                    targets.append((os.path.join(p, f), parsed[0], parsed[1]))

    if not targets:
        print("No zip files with CJK names found.")
        return

    # ── Deduplicate names and batch-translate ─────────────────────────────
    unique_names = sorted(set(t[2] for t in targets))
    print(
        f"Found {len(targets)} zip file(s) with {len(unique_names)} unique CJK name(s).\n"
    )

    cache = load_cache()
    translations = {}

    # Pull cached translations first
    uncached = []
    for name in unique_names:
        if name in cache and cache[name] and not contains_cjk(cache[name]):
            translations[name] = cache[name]
        else:
            uncached.append(name)

    if translations:
        print(f"📦 {len(translations)} translation(s) loaded from cache\n")

    cache_hits = len(translations)
    total_batches = (len(uncached) + BATCH_SIZE - 1) // BATCH_SIZE
    total_units = total_batches + 1  # +1 = the renaming phase
    bar.start()
    bar.draw(0, "Translating", f"0/{total_batches} batches  cache: {cache_hits}")

    if uncached:
        if not api_key:
            print(
                "Error: Gemini API Key not found. Pass --api-key, export GEMINI_API_KEY=..., or save to ~/.config/gemini-api-key",
                file=sys.stderr,
            )
            sys.exit(1)
        for i in range(0, len(uncached), BATCH_SIZE):
            batch = uncached[i : i + BATCH_SIZE]
            batch_num = i // BATCH_SIZE + 1
            info = f"batch {batch_num}/{total_batches}  cache: {cache_hits}"
            bar.draw((batch_num - 1) / total_units, "Translating", info)
            try:
                result = translate_batch(batch, api_key)
                translations.update(result)
                cache.update(result)
                save_cache(cache)
                print(f"   ✓ Got {len(result)} translation(s)\n")
            except Exception as e:
                print(
                    f"   ⚠ Batch error ({e}), falling back to item-by-item Gemini API calls..."
                )
                fallback_success = 0
                for single_name in batch:
                    try:
                        res = translate_batch([single_name], api_key)
                        if res and single_name in res:
                            translations.update(res)
                            cache.update(res)
                            fallback_success += 1
                        else:
                            print(
                                f"   ↳ Skipping '{single_name}' (API response missing key)"
                            )
                    except Exception as single_err:
                        print(f"   ↳ Skipping '{single_name}' ({single_err})")
                save_cache(cache)
                print(
                    f"   ✓ Translated {fallback_success}/{len(batch)} item(s) via individual API calls\n"
                )

            bar.draw(batch_num / total_units, "Translating", info)
            if batch_num < total_batches:
                bar.sleep(10, "rate-limit pause")  # respect free-tier rate limits

    # ── Apply renames ─────────────────────────────────────────────────────
    renamed = 0
    skipped = 0
    skipped_details = []
    total_files = len(targets)

    for idx, (full_path, file_id, cjk_name) in enumerate(
        sorted(targets, key=lambda t: t[1])
    ):
        bar.draw(
            (total_batches + idx / max(1, total_files)) / total_units,
            "Renaming",
            f"{idx}/{total_files}  {skipped} skipped",
        )
        old_basename = os.path.basename(full_path)
        eng = translations.get(cjk_name)

        if not eng or contains_cjk(eng):
            reason = (
                "no translation available" if not eng else "translation contains CJK"
            )
            skipped_details.append(f"  {old_basename} — {reason}")
            skipped += 1
            continue

        eng = clean_filename(eng)

        # Avoid duplicates when original already has the English text
        half = len(eng) // 2
        if half > 10:
            first_half = eng[:half].strip().lower()
            second_half = eng[half:].strip().lower()
            if (
                first_half
                and second_half
                and (first_half in second_half or second_half in first_half)
            ):
                eng = eng[:half].strip()

        new_basename = f"{file_id}_{eng}.zip"

        if old_basename == new_basename:
            continue

        new_path = os.path.join(os.path.dirname(full_path), new_basename)

        if args.dry_run:
            print(f"  {old_basename}")
            print(f"    → {new_basename}\n")
        else:
            try:
                os.rename(full_path, new_path)
                print(f"  {old_basename}")
                print(f"    → {new_basename}\n")
            except Exception as e:
                print(f"  ERROR {old_basename}: {e}", file=sys.stderr)
                skipped_details.append(f"  {old_basename} — error: {e}")
                skipped += 1
                continue
        renamed += 1

    bar.draw(1, "Renaming", f"{total_files}/{total_files}  {skipped} skipped")
    bar.stop()

    elapsed = time.time() - start_time
    print("========================================")
    print("SUMMARY")
    print("========================================")
    print(f"Renamed:             {renamed}")
    print(f"Skipped:             {skipped}")
    print(f"Cached:              {cache_hits}")
    print(f"API calls:           {total_batches} batches")
    print(f"Total time:          {elapsed:.2f} seconds")
    print("========================================\n")

    if skipped_details:
        print("Skipped files:")
        for detail in skipped_details:
            print(detail)


if __name__ == "__main__":
    main()
