#!/usr/bin/env python3
"""
Translates Chinese, Japanese & Korean (CJK) directory, zip, and image file names into English (or Romaji/Pinyin).
Uses free online translation services with caching and local Romaji/Pinyin fallback.

Usage:
    ./translate-names [-r] [-n] [--romaji] [path...]

Options:
    -r, --recursive   Process subdirectories recursively
    -n, --dry-run     Show proposed renames without changing files
    --romaji          Use phonetic Romanization instead of English translation
"""

import os
import re
import sys
import json
import time
import subprocess
import urllib.request
import urllib.parse
import argparse

CACHE_FILE = os.path.expanduser("~/.cache/antigravity_translation_cache.json")
_cache = {}

def load_cache():
    global _cache
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r", encoding="utf-8") as f:
                _cache = json.load(f)
        except Exception:
            _cache = {}

def save_cache():
    try:
        os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
        with open(CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump(_cache, f, ensure_ascii=False, indent=2)
    except Exception:
        pass

def contains_cjk(text):
    return bool(re.search(r'[\uac00-\ud7a3\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff]', text))

def uconv_romaji(text):
    try:
        proc = subprocess.run(['uconv', '-x', 'Any-Latin; Latin-ASCII'], input=text, text=True, capture_output=True, check=True)
        out = proc.stdout.strip()
        out = out.replace('ー', '-').replace('・', ' ')
        return out
    except Exception:
        return text

def translate_cjk_to_english(text):
    if not contains_cjk(text):
        return text

    if text in _cache:
        return _cache[text]

    # Detect language: Japanese if Hiragana/Katakana present, otherwise Korean
    lang = "ja" if any("\u3040" <= c <= "\u30ff" for c in text) else "ko"

    # 1. Try MyMemory API
    try:
        url = f"https://api.mymemory.translated.net/get?q={urllib.parse.quote(text)}&langpair={lang}|en"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            result = data.get("responseData", {}).get("translatedText", "").strip()
            if result and not contains_cjk(result) and "QUERY LENGTH LIMIT EXCEEDED" not in result:
                _cache[text] = result
                save_cache()
                return result
    except Exception:
        pass

    # 2. Try Google Translate web endpoint fallback
    try:
        url = f"https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=en&dt=t&q={urllib.parse.quote(text)}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            result = "".join([chunk[0] for chunk in data[0] if chunk[0]]).strip()
            if result and not contains_cjk(result):
                _cache[text] = result
                save_cache()
                return result
    except Exception:
        pass

    # 3. Fallback to uconv if network unavailable
    result = uconv_romaji(text)
    _cache[text] = result
    save_cache()
    return result

def clean_translated_filename(orig, translated):
    if not translated or translated == orig:
        return orig

    # Retain tags like [LUXsumildo], [mp4], etc.
    tags = re.findall(r'\[[^\]]+\]', orig)
    
    # Strip any invalid OS filename characters
    clean = re.sub(r'[\\/:*?"<>|]', '', translated)
    clean = re.sub(r'\s+', ' ', clean).strip()

    # Check if translation deleted main text leaving only bracket tags
    check_stem = re.sub(r'\[[^\]]+\]', '', clean).strip()
    if not check_stem:
        return uconv_romaji(orig)

    # Re-attach tags if missing from translation
    for tag in tags:
        if tag not in clean:
            clean = f"{clean} {tag}"

    clean = re.sub(r'\s+', ' ', clean).strip()
    return clean

def romanize_name(name, mode="english"):
    if not contains_cjk(name):
        return name

    stem, ext = os.path.splitext(name)
    if name.endswith('.av1.mp4'):
        stem = name[:-8]
        ext = '.av1.mp4'

    if mode == "english":
        trans = translate_cjk_to_english(stem)
    else:
        trans = uconv_romaji(stem)

    clean_stem = clean_translated_filename(stem, trans)
    return clean_stem + ext

def process_renames(paths, recursive=False, dry_run=False, mode="english"):
    load_cache()
    targets = []
    if not paths:
        paths = ['.']

    for p in paths:
        if os.path.isfile(p) or os.path.isdir(p):
            abs_p = os.path.abspath(p)
            if os.path.isdir(abs_p) and recursive:
                for root, dirs, files in os.walk(abs_p, topdown=False):
                    # Skip .git and benchmark directories
                    if '.git' in root or 'avif-benchmark-' in root:
                        continue
                    for fname in files:
                        targets.append(os.path.join(root, fname))
                    for dname in dirs:
                        targets.append(os.path.join(root, dname))
            targets.append(abs_p)

    # Process deeper items first (bottom-up)
    targets = sorted(list(set(targets)), key=lambda x: len(x.split(os.sep)), reverse=True)

    renamed_count = 0
    for target in targets:
        dir_name, base_name = os.path.split(target)
        if not contains_cjk(base_name):
            continue

        new_base = romanize_name(base_name, mode=mode)
        if new_base == base_name or not new_base:
            continue

        new_path = os.path.join(dir_name, new_base)

        if dry_run:
            print(f"[DRY-RUN] '{base_name}'\n       -> '{new_base}'\n")
            renamed_count += 1
        else:
            try:
                os.rename(target, new_path)
                print(f"Renamed: '{base_name}'\n      -> '{new_base}'\n")
                renamed_count += 1
            except Exception as e:
                print(f"Error renaming '{base_name}': {e}", file=sys.stderr)

    if dry_run:
        print(f"Dry run completed. {renamed_count} item(s) would be renamed.")
    else:
        print(f"Successfully renamed {renamed_count} item(s).")

def main():
    parser = argparse.ArgumentParser(description="Translate Chinese/Japanese/Korean CJK folder, zip, and image names to English (or Romaji/Pinyin).")
    parser.add_argument("paths", nargs="*", help="Files or directories to rename")
    parser.add_argument("-r", "--recursive", action="store_true", help="Process subdirectories recursively")
    parser.add_argument("-n", "--dry-run", action="store_true", help="Show proposed renames without changing files")
    parser.add_argument("--romaji", action="store_true", help="Use phonetic Romanization instead of English translation")
    args = parser.parse_args()

    mode = "romaji" if args.romaji else "english"
    process_renames(args.paths, recursive=args.recursive, dry_run=args.dry_run, mode=mode)

if __name__ == "__main__":
    main()
