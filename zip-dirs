#!/usr/bin/env fish
# Zips each subdirectory of the current folder into "<dirname>.zip".

function show_help
    echo "Usage: zip-dirs [-k] [-h]"
    echo ""
    echo "Zips each subdirectory of the current folder into its own <dirname>.zip file."
    echo ""
    echo "  -k, --keep    keep original directories instead of trashing them"
    echo "  -h, --help    show this help and exit"
end

argparse 'h/help' 'k/keep' -- $argv
or exit 1

if set -q _flag_help
    show_help
    exit 0
end

for cmd in zip
    if not command -q $cmd
        echo "Error: required command '$cmd' is not installed." >&2
        exit 1
    end
end

if not set -q _flag_keep; and not command -q gio
    echo "Warning: 'gio' command not found. Original directories will be kept." >&2
    set _flag_keep 1
end

set dirs
for d in (path filter -t dir * 2>/dev/null)
    set d_clean (string trim -r -c / -- "$d")
    if string match -q 'avif-benchmark-*' -- "$d_clean"
        continue
    end
    set -a dirs "$d_clean"
end

if test (count $dirs) -eq 0
    echo "No subdirectories found to zip."
    exit 0
end

# ───────────── pinned progress bar (bottom row) ─────────────
set -g __pb_on 0
set -g __pb_rows 0
set -g __pb_state 0 "" ""

function pb_start
    isatty stdout; or return
    set -g __pb_rows (tput lines 2>/dev/null)
    string match -qr '^\d+$' -- "$__pb_rows"; or return
    test $__pb_rows -ge 5; or return
    # newline (make room), save cursor, shrink scroll region, restore cursor, step back up
    printf '\n\x1b7\x1b[1;%dr\x1b8\x1b[A' (math $__pb_rows - 1)
    set -g __pb_on 1
end

# usage: pb_draw FRACTION(0..1) LABEL INFO
function pb_draw --argument-names frac label info
    set -g __pb_state $frac "$label" "$info"
    test $__pb_on -eq 1; or return
    set -l cols (tput cols 2>/dev/null; or echo 80)
    set -l f (math "min(1, max(0, $frac))")
    set -l pct (math "floor(100 * $f)")
    set -l bw 40
    set -l filled (math "round($bw * $f)")
    # string join, NOT (cmd)(cmd): an empty substitution would blank the whole bar
    set -l bar (string join '' (string repeat -n $filled '█') (string repeat -n (math "$bw - $filled") '░'))
    set -l line (printf '%-10s %s %3d%%  %s' "$label" "$bar" $pct "$info")
    set line (string sub -l (math "$cols - 1") -- "$line")
    printf '\x1b7\x1b[%d;1H\x1b[2K%s\x1b8' $__pb_rows "$line"
end

function pb_stop
    test $__pb_on -eq 1; or return
    set -g __pb_on 0
    printf '\x1b7\x1b[r\x1b8'                          # reset scroll region, keep cursor
    printf '\x1b7\x1b[%d;1H\x1b[2K\x1b8' $__pb_rows    # wipe the bar row
end

function __pb_on_exit --on-event fish_exit
    pb_stop
end

function __pb_on_int --on-signal INT
    pb_stop
    exit 130
end

function __pb_on_winch --on-signal WINCH
    test $__pb_on -eq 1; or return
    set -g __pb_rows (tput lines 2>/dev/null)
    printf '\x1b7\x1b[1;%dr\x1b8' (math $__pb_rows - 1)
    pb_draw $__pb_state
end
# ──────────────────────────────────────────────────────────

# Line-buffer zip/unzip output so lines appear live instead of in big chunks
set unbuf
command -q stdbuf; and set unbuf stdbuf -oL

set total_dirs (count $dirs)

# zip prints one "adding:" line per file AND per directory entry; find lists the same set
set unit_counts
set total_units 0
for d in $dirs
    set n (find "$d" | count)
    set -a unit_counts $n
    set total_units (math $total_units + $n)
end
set done_units 0
set current_dir 0
set success_zips 0
set fail_zips 0
set total_zip_size 0
set trashed_count 0
set removed_count 0
set trashed_size 0
set kept_count 0

set start_time (date +%s%N)

echo "========================================"
echo "ZIP-DIRS"
echo "========================================"
echo "Directories found: $total_dirs"
echo "========================================"
echo ""

pb_start
pb_draw 0 Zipping "0/$total_dirs"

for d in $dirs
    set current_dir (math $current_dir + 1)
    set dir_units $unit_counts[$current_dir]
    echo "[$current_dir/$total_dirs] Zipping directory: $d"

    set -l k 0
    $unbuf zip -r "$d.zip" "$d" 2>&1 | while read -l line
        printf '%s\n' "$line"
        set k (math $k + 1)
        pb_draw (math "($done_units + $k) / $total_units") Zipping "$current_dir/$total_dirs  $d"
    end
    set zip_status $pipestatus[1]      # must be the very next line after `end`
    set done_units (math $done_units + $dir_units)
    pb_draw (math "$done_units / $total_units") Zipping "$current_dir/$total_dirs  $d"

    if test $zip_status -ne 0
        printf "Error: Failed to zip '%s'. Directory was NOT trashed.\n" "$d" >&2
        set fail_zips (math $fail_zips + 1)
        continue
    end

    set success_zips (math $success_zips + 1)
    set z_size (stat -c %s "$d.zip")
    set total_zip_size (math $total_zip_size + $z_size)
    set z_size_mb (math -s2 "$z_size / 1048576")

    if not set -q _flag_keep
        set item_size (stat -c %s "$d" 2>/dev/null; or echo 0)
        if gio trash -- "$d" >/dev/null 2>&1
            set trashed_count (math $trashed_count + 1)
            set trashed_size (math $trashed_size + $item_size)
            printf "Done: %s.zip (%s MiB) - Trashed 1 item\n" "$d" "$z_size_mb"
        else if rm -rf -- "$d" >/dev/null 2>&1
            set removed_count (math $removed_count + 1)
            set trashed_size (math $trashed_size + $item_size)
            printf "Done: %s.zip (%s MiB) - Removed 1 item\n" "$d" "$z_size_mb"
        else
            printf "Done: %s.zip (%s MiB) - Failed to trash/remove item\n" "$d" "$z_size_mb"
        end
    else
        set kept_count (math $kept_count + 1)
        printf "Done: %s.zip (%s MiB) - Kept 1 item\n" "$d" "$z_size_mb"
    end
end

set end_time (date +%s%N)
set elapsed_secs (math -s2 "($end_time - $start_time) / 1000000000")
set total_zip_size_mb (math -s2 "$total_zip_size / 1048576")
set trashed_size_mb (math -s2 "$trashed_size / 1048576")

pb_draw 1 Zipping "$total_dirs/$total_dirs  done"
pb_stop
echo "========================================"
echo "SUMMARY"
echo "========================================"
echo "Zips created:        $success_zips"
echo "Failed:              $fail_zips"
echo "Total zip size:      $total_zip_size_mb MiB"
set total_trashed_count (math $trashed_count + $removed_count)
echo "Items trashed:       $total_trashed_count ($trashed_size_mb MiB)"
echo "Items kept:          $kept_count"
echo "Total time:          $elapsed_secs seconds"
echo "========================================"
echo "Done."
